{
  "minLines": 10,
  "minTokens": 50,
  "gitignore": true,
  "absolute": false,
  "reporters": [
    "json"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/vendor/**",
    "**/.next/**",
    "**/*.min.js",
    "**/*.lock",
    "**/package-lock.json",
    "**/eslint-suppressions.json",
    "**/.jscpd-report/**",
    "lint/structure.mjs",
    "lint/baseline-ratchet.mjs"
  ],
  "output": ".jscpd-report",
  "path": [
    "src",
    "test",
    "eslint.config.mjs"
  ],
  "format": [
    "typescript",
    "javascript"
  ]
}
