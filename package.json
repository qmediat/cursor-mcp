{
  "name": "@qmediat.io/cursor-mcp",
  "version": "1.2.1",
  "mcpName": "io.github.qmediat/cursor-mcp",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "description": "MCP server for the Cursor CLI (cursor-agent): run Cursor's agent with any model id your plan offers — Composer, Claude, GPT, Gemini, Grok families — through the Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cursor-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "lint": "npm run -s format:check && eslint . && jscpd --config .jscpd.json && node lint/baseline-ratchet.mjs --duplicates .jscpd-report/jscpd-report.json",
    "fmt": "prettier \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
    "format": "npm run -s fmt -- --write",
    "format:check": "npm run -s fmt -- --check"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "cursor",
    "cursor-agent",
    "composer",
    "ai",
    "model-context-protocol",
    "claude-code",
    "multi-model"
  ],
  "homepage": "https://www.qmediat.io/open-source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmediat/cursor-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/qmediat/cursor-mcp/issues"
  },
  "author": "Quantum Media Technologies <dev@qmediat.io> (https://www.qmediat.io)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "jscpd": "5.3.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
